# ==============================================================================
# POPWORLD PLATFORM - CẤU HÌNH BIẾN MÔI TRƯỜNG & HỆ THỐNG (ENVIRONMENT CONFIG)
# Sao chép file này thành .env trên server và điền các giá trị thực tế của bạn
# ==============================================================================

# 1. CẤU HÌNH MÁY CHỦ & PROFILE
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# 2. CỔNG THANH TOÁN TỰ ĐỘNG SEPAY VIETQR (https://my.sepay.vn)
# Khóa bí mật API Key và Webhook Secret xác thực Webhook gửi từ SePay
SEPAY_WEBHOOK_API_KEY=popworld_secret_key_2026
SEPAY_WEBHOOK_SECRET_KEY=popworld_secret_key_2026
# Ngân hàng thụ hưởng: MBBank, VCB, Techcombank, VPBank, ACB, BIDV, VietinBank...
SEPAY_BANK_CODE=MBBank
# Số tài khoản ngân hàng nhận tiền
SEPAY_ACCOUNT_NUMBER=0355416208
# Tên chủ tài khoản (viết hoa không dấu)
SEPAY_ACCOUNT_NAME=POPWORLD OFFICIAL STORE

# 3. LƯU TRỮ HÌNH ẢNH CLOUDINARY MEDIA STORAGE (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=popworld/products

# 4. KẾT NỐI CƠ SỞ DỮ LIỆU MYSQL
# Khi chạy Docker Compose, DB_HOST là 'mysql'
DB_HOST=mysql
DB_PORT=3306
DB_NAME=popworld_db
DB_USERNAME=root
DB_PASSWORD=your_strong_mysql_password
JPA_DDL_AUTO=update

# 5. BẢO MẬT PHIÊN LÀM VIỆC & COOKIE
# Đặt một chuỗi bí mật ngẫu nhiên dài ít nhất 32 ký tự
REMEMBER_ME_KEY=your_random_remember_me_secret_key_2026
# Đặt true khi chạy với HTTPS/Cloudflare, đặt false nếu chạy test HTTP thuần
SESSION_COOKIE_SECURE=false

# 6. CHẾ ĐỘ NẠP DỮ LIỆU MẪU BAN ĐẦU
# Tuyệt đối để false trên môi trường Production
APP_INIT_DEMO_DATA=false
