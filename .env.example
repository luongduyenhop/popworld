# ==============================================================================
# POPWORLD PLATFORM - CẤU HÌNH BIẾN MÔI TRƯỜNG & HỆ THỐNG (ENVIRONMENT CONFIG)
# ==============================================================================

# 1. CỔNG THANH TOÁN TỰ ĐỘNG SEPAY VIETQR (https://my.sepay.vn)
# Khóa bí mật API Key xác thực Webhook gửi từ SePay (phải trùng với cấu hình Webhook trên trang my.sepay.vn)
SEPAY_WEBHOOK_API_KEY=popworld_secret_key_2026
# Ngân hàng thụ hưởng: MBBank, VCB, Techcombank, VPBank, ACB, BIDV, VietinBank...
SEPAY_BANK_CODE=MBBank
# Số tài khoản ngân hàng nhận tiền
SEPAY_ACCOUNT_NUMBER=0355416208
# Tên chủ tài khoản (viết hoa không dấu)
SEPAY_ACCOUNT_NAME=POPWORLD OFFICIAL STORE

# 2. LƯU TRỮ HÌNH ẢNH CLOUDINARY MEDIA STORAGE (https://cloudinary.com)
# (Để trống nếu muốn hệ thống tự động lưu trữ cục bộ Local Storage tại thư mục /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=popworld/products

# 3. KẾT NỐI CƠ SỞ DỮ LIỆU MYSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=popworld_db
DB_USERNAME=root
DB_PASSWORD=admin123

# 4. CHẾ ĐỘ NẠP DỮ LIỆU MẪU BAN ĐẦU
APP_INIT_DEMO_DATA=false
